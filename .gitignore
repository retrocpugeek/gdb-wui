/gdb-wui
*.test
coverage.out
/e2e/node_modules
.mi-log*

# editor state: personal colour choices are not project configuration
/.vscode/

# gdb-wui's decompilation cache, written beside the project it is browsing.
# Not a dotted name: Ghidra refuses any path element starting with a dot.
/gdb-wui-decomp/

# compiled fixtures and the Makefile's scratch output
/testdata/fixtures/*.bin
/build/

# `make docs` output. GitHub builds the published site from docs/ itself, so
# nothing here is ever committed.
/docs/_site/
/docs/.jekyll-cache/
